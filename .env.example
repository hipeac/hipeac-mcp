# Database Configuration (Required)
DATABASE_URL=mysql://user:password@localhost:3306/hipeac

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
