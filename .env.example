# Database Configuration (Required)
DATABASE_URL=mysql://user:password@localhost:3306/hipeac

# HiPEAC MCP Configuration (Required for AI features)
HIPEAC_AI_PROVIDER=mistral
HIPEAC_AI_MAX_TOKENS=400
HIPEAC_AI_TEMPERATURE=0.2
# FAISS index path (auto-detects: /storage/faiss in production, .faiss in dev)
# HIPEAC_FAISS_INDEX_PATH=/custom/path/faiss

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_PROJECT_ID=your-openai-project-id-here

# Django Secret Key (Optional - not used for crypto in this context)
SECRET_KEY=your-secret-key-here

# Sentry Configuration (Optional)
# SENTRY_DSN=your-sentry-dsn-here
